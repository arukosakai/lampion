<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lampion.App</RootNamespace>
    <AssemblyName>Lampion</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lampion.Core\Lampion.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
  </ItemGroup>
  <!-- LibVLC natives follow the target, not the build machine: the RID when publishing, the host otherwise.
       Linux uses the system libvlc (apt install vlc / libvlc-dev). -->
  <PropertyGroup>
    <LampionTargetOs Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier.Split('-')[0])</LampionTargetOs>
    <LampionTargetOs Condition="'$(LampionTargetOs)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win</LampionTargetOs>
    <LampionTargetOs Condition="'$(LampionTargetOs)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">osx</LampionTargetOs>
    <LampionTargetArch Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier.Split('-')[1])</LampionTargetArch>
    <LampionTargetArch Condition="'$(LampionTargetArch)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</LampionTargetArch>
    <!-- Only ship the one CPU architecture being built; all three together are ~500 MB. -->
    <VlcWindowsX64Enabled>$([System.String]::Equals('$(LampionTargetArch)', 'x64'))</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>$([System.String]::Equals('$(LampionTargetArch)', 'x86'))</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>$([System.String]::Equals('$(LampionTargetArch)', 'arm64'))</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <ItemGroup Condition="'$(LampionTargetOs)' == 'osx'">
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(LampionTargetOs)' == 'win'">
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>
</Project>
