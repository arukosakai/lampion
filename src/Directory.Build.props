<Project>
  <!-- Applies to every shipping project under src/. Tests are exempt from the XML doc requirement. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing or mismatched XML docs fail the build instead of piling up as warnings. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1573;CS1572;CS1574</WarningsAsErrors>
  </PropertyGroup>
</Project>
